 alert_bot.py   |  4 ++--
 ws_watch.py    |  7 ++++++-
 ws_watch_1m.py | 10 +++++++---
 3 files changed, 15 insertions(+), 6 deletions(-)

diff --git a/alert_bot.py b/alert_bot.py
index a11e9a5..9fddcc2 100644
--- a/alert_bot.py
+++ b/alert_bot.py
@@ -111,8 +111,8 @@ def fmt_checks(checks):
     return "\n".join(f"  {'✅' if v else '❌'} {k}" for k, v in checks.items())
 
 
-def fmt_signal(e, when, provisional=False, mins_left=None):
-    d = e["direction"]
+def fmt_signal(e, when, provisional=False, mins_left=None, active_dir=None):
+    d = active_dir if active_dir is not None else e["direction"]
     long_ = d == "LONG"
     side = "🟢 롱(LONG)" if long_ else "🔴 숏(SHORT)"
     px = e["close"]
diff --git a/ws_watch.py b/ws_watch.py
index f2e092c..42910c4 100644
--- a/ws_watch.py
+++ b/ws_watch.py
@@ -111,12 +111,17 @@ def handle_tick(st, k):
     d = e.get("direction_active", e["direction"])
     # 같은 봉·같은 방향은 한 번만 (임계선 깜빡임 중복 방지). 되돌림 메시지는 보내지 않음.
     if d and d not in st.alerted_dirs:
+        # 필수조건(선행스팬1·20일선)이 실제로 충족된 경우만 발송
+        must_ok = all((e["must_long"] if d == "LONG" else e["must_short"]).values())
+        if not must_ok:
+            st.alerted_dirs.add(d)
+            return
         mins_left = (when + pd.Timedelta(ab.TF) - pd.Timestamp.now(tz="UTC")).total_seconds() / 60
         mins_left = max(0, mins_left)
         if mins_left < PROV_MIN_MINS_LEFT:
             st.alerted_dirs.add(d)
             return
-        ab.emit(ab.fmt_signal(e, when, provisional=True, mins_left=mins_left))
+        ab.emit(ab.fmt_signal(e, when, provisional=True, mins_left=mins_left, active_dir=d))
         st.alerted_dirs.add(d)
 
 
diff --git a/ws_watch_1m.py b/ws_watch_1m.py
index baf3812..420ad1f 100644
--- a/ws_watch_1m.py
+++ b/ws_watch_1m.py
@@ -103,8 +103,8 @@ def fmt_checks(checks):
     return "\n".join(f"  {'✅' if v else '❌'} {k}" for k, v in checks.items())
 
 
-def fmt_signal(e, when, provisional=False, mins_left=None):
-    d = e["direction"]
+def fmt_signal(e, when, provisional=False, mins_left=None, active_dir=None):
+    d = active_dir if active_dir is not None else e["direction"]
     long_ = d == "LONG"
     side = "🟢 롱(LONG)" if long_ else "🔴 숏(SHORT)"
     px = e["close"]
@@ -220,12 +220,16 @@ def handle_tick(st, k):
         st.alerted_dirs = set()
     d = e.get("direction_active", e["direction"])
     if d and d not in st.alerted_dirs:
+        must_ok = all((e["must_long"] if d == "LONG" else e["must_short"]).values())
+        if not must_ok:
+            st.alerted_dirs.add(d)
+            return
         mins_left = (when + pd.Timedelta(TF) - pd.Timestamp.now(tz="UTC")).total_seconds() / 60
         mins_left = max(0, mins_left)
         if mins_left < PROV_MIN_MINS_LEFT:
             st.alerted_dirs.add(d)
             return
-        emit(fmt_signal(e, when, provisional=True, mins_left=mins_left))
+        emit(fmt_signal(e, when, provisional=True, mins_left=mins_left, active_dir=d))
         st.alerted_dirs.add(d)
 
 
